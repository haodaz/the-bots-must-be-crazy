# Copy to .env.local and fill in. Never commit .env.local.
# Your Meta Model API key (dev.meta.ai -> API keys).
META_API_KEY=
# Live calls happen only when this is 1 (on a public deployment, only with the shared store below). Anything else is a
# free rehearsal.
MODEL_LIVE=0
# Our own spending ceiling, under the $10 of credits.
BUDGET_CAP_USD=8

# ---- Public deployment ----
# The shared store (Upstash Redis). Vercel's Upstash integration sets these.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# One shared pool for every public round, and one grain per round, in US$.
PUBLIC_POOL_USD=4
ROUND_GRAIN_USD=0.04
# New rounds one visitor may start in an hour.
ROUNDS_PER_HOUR=6
# Salt for the anonymous visitor hash.
VISITOR_SALT=
# 0 closes the public pool: visitors then watch a recorded round (public/replay/<lang>.json).
PUBLIC_POOL_OPEN=1
# The judges' pass (at least 6 characters; give judges the link /?pass=<this>) and their own pool, in US$.
JUDGE_PASS=
JUDGE_POOL_USD=1
