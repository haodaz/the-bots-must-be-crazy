# Copy to .env.local and fill in. Never commit .env.local.
# Your Meta Model API key (dev.meta.ai -> API keys).
META_API_KEY=
# Live calls happen only when this is 1 (and never on the public deployment). Anything else is a free rehearsal.
MODEL_LIVE=0
# Our own spending ceiling, under the $10 of credits.
BUDGET_CAP_USD=8
